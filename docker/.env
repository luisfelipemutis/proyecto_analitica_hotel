# ============================================================
# HOTEL DANN MONASTERIO — Variables de entorno Docker
# ============================================================

# ── Airflow ──────────────────────────────────────────────────
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_PORT=8091
AIRFLOW_UID=50000
PYTHONPATH=/opt/airflow/project

# ── MySQL LOCAL del host Windows ─────────────────────────────
# IMPORTANTE: los contenedores Docker NO pueden usar "localhost"
# para llegar al MySQL del host. En Windows/Mac con Docker Desktop
# se usa "host.docker.internal" que Docker resuelve automáticamente.
# En MySQL Workbench sigue usando localhost:3306 sin cambios.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=hotel_dann_dw
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
